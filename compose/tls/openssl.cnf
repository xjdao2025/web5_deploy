[req]
distinguished_name = distinguished_name
req_extensions = server_extensions
prompt = no

[distinguished_name]
CN = *.uat.test

[server_extensions]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @subject_alt_names

[subject_alt_names]
DNS.1 = *.uat.test
DNS.2 = uat.test
